# Copy to .env for local (non-Docker) runs. docker-compose.yml reads this file and overrides
# DATABASE_URL / REDIS_URL / MODEL_DIR etc. for the containers.
ENV=dev
# Local dev without Docker uses SQLite (default) - leave empty. Docker sets Postgres+TimescaleDB.
# DATABASE_URL=postgresql+psycopg://agriroute:agriroute@localhost:5432/agriroute
# Empty => in-memory cache/OTP/rate-limit and eager Celery tasks.
REDIS_URL=

JWT_SECRET=change-me-in-production
JWT_TTL_HOURS=168
# Dev: OTP is always 123456 and is returned by the API. Set false + configure SMS_WEBHOOK_URL in prod.
OTP_DEV_MODE=true
RATE_LIMIT_DEFAULT=300/minute
RATE_LIMIT_OTP=5/minute

# Live data. Without a key (or with USE_LIVE_APIS=false) the synthetic generator is used.
USE_LIVE_APIS=false
DATAGOV_API_KEY=
AGMARKNET_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# ML
ENABLE_PROPHET=true
BACKTEST_SERIES=24
BACKTEST_ORIGINS=4
LGBM_ROUNDS=400
MLFLOW_TRACKING_URI=

# Marketplace commission (percent of deal value)
FARMER_COMMISSION_PCT=0.5
BUYER_COMMISSION_PCT=1.5

# Notification hooks: POST {to, text, channel}. Empty => mocked (logged + notifications_outbox.jsonl)
SMS_WEBHOOK_URL=
WHATSAPP_WEBHOOK_URL=
